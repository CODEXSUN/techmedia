# --- Runtime ---
NODE_ENV=development
PLATFORM_API_PORT=7050
PLATFORM_WEB_PORT=7060
PLATFORM_WEB_ORIGIN=http://app.techmedia.test
PLATFORM_WEB_ORIGINS=http://127.0.0.1:7060,http://localhost:7060
PLATFORM_WEB_HEALTH_URL=
PLATFORM_API_URL=http://127.0.0.1:7050

# --- Database ---
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_MASTER_NAME=tm_master_db

# Database lifecycle.
# TECHMEDIA_DB_FRESH_ON_START=1 drops and rebuilds configured databases on API startup.
# Destructive actions require TECHMEDIA_DB_RESET_CONFIRM=DROP_DATABASES.
# Production additionally requires TECHMEDIA_ALLOW_PRODUCTION_DB_RESET=1.
TECHMEDIA_DB_FRESH_ON_START=0
TECHMEDIA_DB_RESET_CONFIRM=
TECHMEDIA_ALLOW_PRODUCTION_DB_RESET=0

# Database maintenance and queue-backed backup/restore.
TECHMEDIA_BACKUP_DIR=storage/backups/database
TECHMEDIA_RESTORE_TEST_DB_NAME=
TECHMEDIA_VERIFIED_BACKUP_ID=
TECHMEDIA_ALLOW_LIVE_RESTORE=0
TECHMEDIA_LIVE_RESTORE_CONFIRM=

# Runtime storage roots. Tenant roots are derived beneath these locations.
STORAGE_ROOT=storage/app
STORAGE_PUBLIC_ROOT=storage/public

# Queue backend. Use database locally; BullMQ/Redis is reserved for cloud scale.
TECHMEDIA_QUEUE_BACKEND=database
TECHMEDIA_REDIS_URL=redis://127.0.0.1:6379

TECHMEDIA_QUEUE_WORKER_ENABLED=1
TECHMEDIA_QUEUE_WORKER_INTERVAL_MS=5000
TECHMEDIA_QUEUE_COMPLETED_RETENTION_DAYS=14
TECHMEDIA_QUEUE_FAILED_RETENTION_DAYS=30

# Dedicated key for encrypting tenant integration credentials.
# When blank, the API uses JWT_SECRET for backward-compatible local development.
TECHMEDIA_INTEGRATION_ENCRYPTION_KEY=

# Test-only default first tenant seed. Keep disabled for normal/live runtime.
# Set ENABLE_DEFAULT_TENANT_SEED=1 only for local smoke tests or e2e runs.
ENABLE_DEFAULT_TENANT_SEED=0
DEV_AUTO_TENANT_LOGIN=0
TENANT_DOMAIN_BASE=localhost
DEFAULT_TENANT_NAME=TechMedia
DEFAULT_TENANT_CORPORATE_ID=TECHMEDIA
DEFAULT_TENANT_SLUG=techmedia
DEFAULT_TENANT_DB_NAME=techmedia_db
DEFAULT_TENANT_DOMAIN=app.techmedia.test
DEFAULT_TENANT_ADMIN_NAME=
DEFAULT_TENANT_ADMIN_EMAIL=
DEFAULT_TENANT_ADMIN_PASSWORD=

# --- Auth ---
# REQUIRED. No fallback.
JWT_SECRET=

# Auth mode: "jwt" (default, bearer token), "cookie" (web sessions), or "hybrid" (both).
AUTH_MODE=jwt

# --- Seed users (blank on live deployments) ---
# Optional first platform users. Leave blank on live and create users
# manually unless this deployment intentionally needs a seeded account.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=

# Optional tenant setup helper account. Leave blank on live unless you
# intentionally want every newly setup tenant to receive this admin user.
TENANT_ADMIN_NAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=

# --- Dev / Tooling ---
# Set to "abort" to prevent the dev preflight from killing active listeners.
# TECHMEDIA_DEV_PORT_POLICY=abort

# Optional database-user helper overrides. Keep passwords only in local .env.
DB_ADMIN_PASSWORD=
# MARIADB_CLIENT=C:\Program Files\MariaDB 12.3\bin\mariadb.exe

# Set to 1 for faster local restarts when the database is already prepared.
# Skips the API database preflight and startup database bootstrap.
TECHMEDIA_DEV_SKIP_DB=0

# Database safety command guards.
# Required for npm run db:migrations:test-local after restoring a dump locally.
TECHMEDIA_RESTORED_DUMP_TEST=0

# Required for npm run db:backup:verify.
TECHMEDIA_BACKUP_VERIFY_ID=

