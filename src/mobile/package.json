{
  "name": "@techmedia/mobile",
  "version": "1.0.50",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:generate": "python tools/generate-brand-assets.py",
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite --host 127.0.0.1 --port 7070",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "sync": "npm run build && cap sync",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "bundle:release": "cd android && gradlew.bat bundleRelease",
    "run:android": "cap run android",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/react": "^9.0.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "ionicons": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
