ARG NODE_RUNTIME_VERSION=26.5.0
FROM node:${NODE_RUNTIME_VERSION}-bookworm-slim AS build
ARG NPM_RUNTIME_VERSION=12.0.1
WORKDIR /workspace
RUN npm install --global npm@${NPM_RUNTIME_VERSION}
COPY framework ./framework
COPY core ./core
COPY ui ./ui
COPY techmedia ./techmedia
WORKDIR /workspace/techmedia
RUN npm ci && npm run setup && npm run build && npm run dependencies:check

FROM build AS migrations
ENV NODE_ENV=production
CMD ["npm", "run", "db:migrations:run"]

FROM build AS production-dependencies
RUN npm prune --omit=dev \
  && npm prune --omit=dev --prefix ../framework \
  && npm prune --omit=dev --prefix ../core

FROM node:${NODE_RUNTIME_VERSION}-bookworm-slim AS runtime
ARG TECHMEDIA_VERSION=1.0.1
ARG NPM_RUNTIME_VERSION=12.0.1
LABEL org.opencontainers.image.title="Techmedia Platform API" org.opencontainers.image.version="$TECHMEDIA_VERSION"
WORKDIR /workspace/techmedia
RUN npm install --global npm@${NPM_RUNTIME_VERSION} \
  && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates mariadb-client \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /storage/app /storage/public /storage/tenants /storage/backups/database \
  && chown -R node:node /storage /workspace
COPY --from=production-dependencies /workspace/framework /workspace/framework
COPY --from=production-dependencies /workspace/core /workspace/core
COPY --from=production-dependencies /workspace/techmedia /workspace/techmedia
COPY techmedia/.container/scripts/api-entrypoint.sh /usr/local/bin/techmedia-api-entrypoint
RUN cp -a /workspace/core/dist/api /workspace/core/api/dist \
  && sed -i 's#./src/index.ts#./dist/index.js#g' /workspace/core/api/package.json \
  && rm -rf /workspace/techmedia/storage \
  && ln -s /storage/tenants /workspace/techmedia/storage \
  && chmod +x /usr/local/bin/techmedia-api-entrypoint
ENV NODE_ENV=production
USER node
EXPOSE 7050
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=10 CMD node -e "fetch('http://127.0.0.1:'+process.env.PLATFORM_API_PORT+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["techmedia-api-entrypoint"]
