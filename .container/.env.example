# TechMedia production runtime
NODE_ENV=production
# India Standard Time (UTC+05:30)
TZ=Asia/Kolkata
AUTH_MODE=jwt
DEV_AUTO_LOGIN=0

# TechMedia Platform API and Web
PLATFORM_API_PORT=7050
PLATFORM_API_URL=http://127.0.0.1:7050
PLATFORM_WEB_PORT=7060
PLATFORM_WEB_ORIGIN=http://127.0.0.1:7060
PLATFORM_WEB_ORIGINS=
PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:7060/status
VITE_PLATFORM_API_URL=http://127.0.0.1:7050
VITE_DEV_AUTO_LOGIN=0

# Setup synchronizes DB_USER, DB_PASSWORD, and DB_NAME from deploy.env.
DB_DRIVER=mariadb
DB_HOST=codexsun-mariadb
DB_PORT=3306
DB_USER=techmedia
DB_PASSWORD=Computer.1
DB_NAME=techmedia_db

# Authentication and protected administrator
JWT_SECRET=generate-with-setup
INITIAL_ADMIN_NAME=Mahendran
INITIAL_ADMIN_EMAIL=mahendran@techmedia.in
INITIAL_ADMIN_PASSWORD=

# Optional dedicated Frappe credential encryption key.
# When empty, TechMedia derives credential encryption from JWT_SECRET.
TECHMEDIA_INTEGRATION_ENCRYPTION_KEY=

# Live Frappe connection
FRAPPE_ENABLED=1
FRAPPE_CONNECTION_NAME=Frappe
FRAPPE_BASE_URL=https://logicx.tmnext.in
FRAPPE_APP_KEY=
FRAPPE_APP_SECRET=
FRAPPE_LAST_CHECKED_AT=
FRAPPE_LAST_VERIFIED_AT=
FRAPPE_UPDATED_AT=
FRAPPE_VERIFICATION_STATUS=unverified

# Destructive database reset remains disabled
TECHMEDIA_DB_FRESH_ON_START=0
TECHMEDIA_DB_RESET_CONFIRM=
TECHMEDIA_ALLOW_PRODUCTION_DB_RESET=0
