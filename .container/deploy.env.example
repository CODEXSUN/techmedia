# Docker project and images
TECHMEDIA_COMPOSE_PROJECT=techmedia
TECHMEDIA_IMAGE_REGISTRY=techmedia
TECHMEDIA_IMAGE_TAG=local
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.1
TECHMEDIA_BACKUP_RETENTION=10

# Docker resources
TECHMEDIA_API_CONTAINER_NAME=techmedia-api
TECHMEDIA_WEB_CONTAINER_NAME=techmedia-web
TECHMEDIA_MARIADB_CONTAINER_NAME=techmedia-mariadb
TECHMEDIA_NETWORK=techmedia-network
TECHMEDIA_NETWORK_EXTERNAL=false
TECHMEDIA_MARIADB_DATA_VOLUME=techmedia-mariadb-data

# Loopback publishing
TECHMEDIA_BIND_ADDRESS=127.0.0.1
TECHMEDIA_API_INTERNAL_PORT=7050
TECHMEDIA_API_HOST_PORT=7050
TECHMEDIA_WEB_HOST_PORT=7060

# Standalone MariaDB infrastructure
MARIADB_IMAGE=mariadb:11.8
MARIADB_ROOT_PASSWORD=generate-with-setup
DB_USER=techmedia
DB_PASSWORD=generate-with-setup
DB_NAME=techmedia_db

# Optional reuse of an already-running shared infrastructure stack.
# TechMedia connects only to MariaDB; Redis and Media are detected but unused.
TECHMEDIA_SHARED_MARIADB_CONTAINER_NAME=cxapp-mariadb
TECHMEDIA_SHARED_REDIS_CONTAINER_NAME=cxapp-redis
TECHMEDIA_SHARED_MEDIA_CONTAINER_NAME=cxapp-media
TECHMEDIA_SHARED_MARIADB_ROOT_PASSWORD=
