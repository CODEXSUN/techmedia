NODE_ENV=production
TECHMEDIA_VERSION=1.0.2
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.1
TECHMEDIA_IMAGE_REGISTRY=codexsun
TECHMEDIA_BIND_ADDRESS=127.0.0.1
CODEXSUN_EDGE_NETWORK=codexsun-network
TECHMEDIA_WEB_HOST=app.techmedia.in

PLATFORM_API_PORT=7050
PLATFORM_WEB_PORT=7060
PLATFORM_API_HOST_PORT=18050
PLATFORM_WEB_HOST_PORT=18060
PLATFORM_API_URL=http://techmedia-api:7050
PLATFORM_WEB_ORIGIN=https://app.techmedia.in
PLATFORM_WEB_ORIGINS=http://127.0.0.1:18060,http://localhost:18060
PLATFORM_WEB_HEALTH_URL=http://techmedia-web:80

DB_DRIVER=mariadb
DB_HOST=codexsun-mariadb
DB_PORT=3306
DB_USER=codexsun_app
DB_PASSWORD=inherited_from_codexsun
DB_MASTER_NAME=techmedia_master

TECHMEDIA_REDIS_PASSWORD=inherited_from_codexsun
TECHMEDIA_QUEUE_BACKEND=bullmq-redis
TECHMEDIA_REDIS_URL=redis://:inherited_from_codexsun@codexsun-redis:6379/1
TECHMEDIA_QUEUE_WORKER_ENABLED=1
TECHMEDIA_QUEUE_WORKER_INTERVAL_MS=5000
TECHMEDIA_QUEUE_COMPLETED_RETENTION_DAYS=14
TECHMEDIA_QUEUE_FAILED_RETENTION_DAYS=30

TECHMEDIA_API_IMAGE_TAG=1.0.2
TECHMEDIA_WEB_IMAGE_TAG=1.0.2
TECHMEDIA_MIGRATIONS_IMAGE_TAG=1.0.2
TECHMEDIA_DATA_VOLUME=techmedia-platform-data
STORAGE_ROOT=/storage/app
STORAGE_PUBLIC_ROOT=/storage/public

JWT_SECRET=change_this_techmedia_jwt_secret
AUTH_MODE=jwt
SUPER_ADMIN_NAME=TechMedia Super Admin
SUPER_ADMIN_EMAIL=admin@techmedia.in
SUPER_ADMIN_PASSWORD=change_this_techmedia_super_admin_password
SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=
TENANT_ADMIN_NAME=TechMedia Administrator
TENANT_ADMIN_EMAIL=admin@techmedia.in
TENANT_ADMIN_PASSWORD=change_this_techmedia_tenant_admin_password

ENABLE_DEFAULT_TENANT_SEED=1
DEFAULT_TENANT_CORPORATE_ID=TECHMEDIA
DEFAULT_TENANT_DB_NAME=techmedia_tenant_default
DEFAULT_TENANT_DOMAIN=app.techmedia.in
DEFAULT_TENANT_NAME=TechMedia
DEFAULT_TENANT_SLUG=techmedia
DEFAULT_TENANT_ADMIN_NAME=TechMedia Administrator
DEFAULT_TENANT_ADMIN_EMAIL=admin@techmedia.in
DEFAULT_TENANT_ADMIN_PASSWORD=change_this_techmedia_tenant_admin_password
TENANT_DOMAIN_BASE=techmedia.in
DEV_AUTO_TENANT_LOGIN=0

TECHMEDIA_DB_FRESH_ON_START=0
TECHMEDIA_DB_RESET_CONFIRM=
TECHMEDIA_ALLOW_PRODUCTION_DB_RESET=0
TECHMEDIA_VERIFIED_BACKUP_ID=initial-empty-database
TECHMEDIA_BACKUP_DIR=/storage/backups/database
TECHMEDIA_RESTORE_TEST_DB_NAME=
TECHMEDIA_ALLOW_LIVE_RESTORE=0
TECHMEDIA_LIVE_RESTORE_CONFIRM=
