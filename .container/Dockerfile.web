ARG NODE_RUNTIME_VERSION=26.5.0
FROM node:${NODE_RUNTIME_VERSION}-bookworm-slim AS build
ARG NPM_RUNTIME_VERSION=12.0.1
ARG DEFAULT_TENANT_NAME=TechMedia
ENV DEFAULT_TENANT_NAME=$DEFAULT_TENANT_NAME
ENV NODE_ENV=development
WORKDIR /workspace
RUN npm install --global npm@${NPM_RUNTIME_VERSION}
COPY framework ./framework
COPY core ./core
COPY ui ./ui
COPY techmedia ./techmedia
WORKDIR /workspace/techmedia
RUN npm ci && npm run setup
ENV NODE_ENV=production
RUN npm run build --prefix ../framework \
  && npm run build --workspace @techmedia/platform-web \
  && npm run dependencies:check

FROM nginx:1.28-alpine AS runtime
ARG TECHMEDIA_VERSION=1.0.2
LABEL org.opencontainers.image.title="Techmedia Platform Web" org.opencontainers.image.version="$TECHMEDIA_VERSION"
COPY techmedia/.container/scripts/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/techmedia/dist/apps/platform/web /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1
